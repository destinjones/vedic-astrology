{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "planet-in-nakshatra.schema.json",
  "title": "Hand-written planet in nakshatra readings for one graha",
  "description": "Any nakshatra left out keeps the reading composed from the nakshatra, the planet and the lord relationship. The pada line is always added after your text.",
  "type": "object",
  "required": ["planet", "readings"],
  "additionalProperties": false,
  "properties": {
    "planet": { "enum": ["sun", "moon", "mars", "mercury", "jupiter", "venus", "saturn", "rahu", "ketu"] },
    "readings": {
      "type": "object",
      "propertyNames": { "enum": ["ashwini", "bharani", "krittika", "rohini", "mrigashira", "ardra", "punarvasu", "pushya", "ashlesha", "magha", "purva-phalguni", "uttara-phalguni", "hasta", "chitra", "swati", "vishakha", "anuradha", "jyeshtha", "mula", "purva-ashadha", "uttara-ashadha", "shravana", "dhanishta", "shatabhisha", "purva-bhadrapada", "uttara-bhadrapada", "revati"] },
      "additionalProperties": { "$ref": "reading.schema.json" }
    }
  }
}

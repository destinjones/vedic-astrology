{
  "version": 1,
  "conventions": {
    "wheelPlate": "wheel/wheel-top.webp is an orthographic plate: the wheel's rim (radius 10 units) fills 20/20.4 of the image width. 0 deg sidereal Aries is at 3 o'clock and longitude increases counterclockwise.",
    "pointOnWheelPlate": "x = 0.5 + r/20.4 * cos(lon), y = 0.5 - r/20.4 * sin(lon) in image fractions (y down); r in wheel units.",
    "rotatingThePlate": "Rotating the image clockwise by a degrees moves longitude lon to screen angle lon - a (counterclockwise from 3 o'clock). To put the ascendant at 9 o'clock, use a = ascendant - 180.",
    "wheelRadii": {
      "grahaTrackInner": 3.19,
      "grahaTrackOuter": 4.15,
      "rashiInner": 4.25,
      "rashiOuter": 6.75,
      "nakshatraInner": 6.95,
      "nakshatraOuter": 9.35,
      "padaOuter": 9.75,
      "rim": 10.0
    },
    "gltf": "Models are Y-up with the wheel in the XZ plane. Longitude lon on the wheel maps to three.js position (r*cos(lon), h, -r*sin(lon)). Graha models have radius 1 (Shani's ring reaches 2.35); wheel.glb has radius 10.",
    "materials": "Surya and the wheel use emissive maps, so they read without lights. Other grahas need scene lighting.",
    "sky": "backgrounds/sky-equirect.webp is decorative procedural art, not a real star catalogue. Do not present it as actual star positions."
  },

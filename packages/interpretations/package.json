{
  "name": "@vedic/interpretations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Original Vedic astrology interpretation knowledge base: placements, dignities, house lords, conjunctions, aspects, yogas and doshas with detection rules.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "export-json": "tsx scripts/export-json.ts",
    "content": "tsx scripts/build-content.ts && tsx scripts/coverage-report.ts",
    "content:check": "tsx scripts/build-content.ts --check && tsx scripts/coverage-report.ts --check"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ajv": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@vedic/engine": "*",
    "@vedic/i18n": "*"
  }
}
